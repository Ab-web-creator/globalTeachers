SITE_URL=http://localhost:3000
RESEND_API_KEY=
CONSULTATION_EMAIL_FROM=TeacherNavigator <info@teachernavigator.com>
CONSULTATION_EMAIL_TO=
# Inbound mail: signing secret of the Resend email.received webhook (whsec_...)
RESEND_WEBHOOK_SECRET=
# Optional comma-separated addresses that receive a copy of every incoming email
MAILBOX_FORWARD_TO=
# PostgreSQL connection string from your database provider
DATABASE_URL=
# Protects the scheduled cleanup/notification endpoint; generate with openssl rand -hex 32
CRON_SECRET=

# Private /admin page (password at least 16 characters)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Filled automatically by npm run db:setup for Docker-based local development
LOCAL_DATABASE_MANAGED=
LOCAL_DATABASE_PASSWORD=
LOCAL_DATABASE_PORT=55433

# Optional override for the server-only city geolocation database.
# Defaults to .local/geoip/city.mmdb. Populate it with npm run geoip:update.
ANALYTICS_GEOIP_DATABASE=
